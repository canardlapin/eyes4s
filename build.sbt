// The full API audit (compileAll plus one JaCoCo-instrumented sbt launch per module)
// and the published-artifact consumer (publishLocal plus an isolated JVM/JS build) are
// too slow for every push. They run weekly and on demand; the per-push Checks keep
// the fast, platform-aware documentation evidence check.
def scheduledEvidenceWorkflow: String = {
  def job(id: String, name: String, command: String, artifact: String, paths: Seq[String]) =
    s"""|  $id:
        |    name: $name
        |    runs-on: ubuntu-22.04
        |    timeout-minutes: 120
        |    steps:
        |      - name: Checkout current revision
        |        uses: actions/checkout@v6
        |        with:
        |          fetch-depth: 0
        |
        |      - name: Setup sbt
        |        uses: sbt/setup-sbt@v1
        |
        |      - name: Setup Java
        |        uses: actions/setup-java@v5
        |        with:
        |          distribution: temurin
        |          java-version: 17
        |          cache: sbt
        |
        |      - name: $name
        |        run: $command
        |
        |      - name: Upload evidence
        |        if: always()
        |        uses: actions/upload-artifact@v4
        |        with:
        |          name: $artifact-$${{ github.sha }}
        |          path: |
        |__PATHS__
        |          if-no-files-found: warn
        |""".stripMargin.replace("__PATHS__", paths.map("            " + _).mkString("\n"))

  """|# This file is generated by the githubWorkflowGenerate task in build.sbt.
     |# Do not edit it directly.
     |
     |name: Scheduled Evidence
     |
     |on:
     |  workflow_dispatch:
     |  schedule:
     |    - cron: '41 5 * * 1'
     |
     |permissions:
     |  contents: read
     |
     |concurrency:
     |  group: scheduled-evidence-${{ github.ref }}
     |  cancel-in-progress: true
     |
     |jobs:
     |""".stripMargin +
    job(
      "api-audit",
      "Audit public API inventory and executed evidence",
      "python3 tools/api-audit/run.py",
      "api-audit",
      Seq("target/api-audit/")
    ) + "\n" +
    job(
      "artifact-consumer",
      "Check the isolated published-artifact consumer",
      "python3 tools/check-docs.py --platform none --run-consumer",
      "artifact-consumer",
      Seq(
        "target/documentation-consumer.log",
        "target/study-consumer/publish.log",
        "target/study-consumer/consumer.log",
        "target/study-consumer/receipt.json"
      )
    )
}

