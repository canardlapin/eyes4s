  .crossType(CrossType.Pure)
  .jvmSettings(ApiAudit.settings)
  .in(file("kernel"))
  .settings(commonSettings, pureModuleSettings)
  .settings(
    name                                    := "eyes4s-kernel",
    libraryDependencies += "org.typelevel" %%% "cats-core" % catsV
